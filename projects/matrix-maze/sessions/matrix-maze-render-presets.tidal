-- Matrix-Maze render presets
-- Goal: copy/paste one block at a time while recording stems.
-- Start each block at a bar boundary, then record the target length.

-------------------------------------------------
-- BASE stem (matrix_maze_base.wav)
-------------------------------------------------
do
  hush
  setcps 0.86
  d1
    $ stack
    [ s "bd*2 [~ bd] bd*2 [~ bd]"
    , s "~ sn:2 ~ [~ sn:2]"
    ]
    # gain 1
    # room 0.08
    # size 0.2
  d2
    $ s "[~ lt] ~ [lt ~] [~ cp]"
    # gain 0.5
    # shape 0.18
    # speed 0.9
  d3
    $ n "0 ~ [0 0] ~"
    # s "bass3"
    # legato 0.85
    # sustain 0.22
    # gain 0.8
    # lpf 950
    # resonance 0.25
  d4
    $ every 6 (rev)
    $ slow 2
    $ s "[~ ~ industrial:3] ~"
    # gain 0.2
    # hpf 600
    # room 0.3
    # size 0.5

-------------------------------------------------
-- PRESSURE stem (matrix_maze_pressure.wav)
-------------------------------------------------
do
  hush
  setcps 0.86
  d5
    $ every 4 (jux (iter 2))
    $ s "hc*8"
    # gain 0.32
    # hpf 4200
    # speed "1 1.02 0.98 1.01"

-------------------------------------------------
-- CHASE stem (matrix_maze_chase.wav)
-------------------------------------------------
do
  hush
  setcps 0.86
  d6
    $ every 3 (stut 3 0.125 0.9)
    $ s "amencutup*2"
    # gain 0.42
    # cut 1
    # hpf 180
    # lpf 4200

-------------------------------------------------
-- DREAD stem (matrix_maze_dread.wav)
-------------------------------------------------
do
  hush
  setcps 0.86
  d4
    $ every 6 (rev)
    $ slow 2
    $ s "[~ ~ industrial:3] ~"
    # gain 0.2
    # hpf 600
    # room 0.3
    # size 0.5
  d7
    $ n "<[0 3] [~ 5] [7 ~] [3 10]>"
    # s "supersaw"
    # gain 0.22
    # sustain 0.15
    # crush 2
    # lpf 1300
    # room 0.35
    # size 0.6

-- Stop all:
-- hush

